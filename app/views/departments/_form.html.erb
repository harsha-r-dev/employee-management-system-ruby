<% if @department.errors.any? %>
  <div style="color: red;">
    <h3>
      <%= pluralize(@department.errors.count, "error") %>
      prevented this department from being saved:
    </h3>

    <ul>
      <% @department.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @department do |f| %>

  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>

  <br>

  <div>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>

  <br>

  <div>
    <%= f.submit %>
  </div>

<% end %>