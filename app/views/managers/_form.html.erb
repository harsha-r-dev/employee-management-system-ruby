<% if @manager.errors.any? %>
  <div style="color: red;">
    <h3>
      <%= pluralize(@manager.errors.count, "error") %>
      prevented this manager from being saved:
    </h3>

    <ul>
      <% @manager.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @manager do |f| %>

  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>

  <br>

  <div>
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </div>

  <br>

  <div>
    <%= f.submit %>
  </div>

<% end %>